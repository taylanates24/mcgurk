# --- Stimuli ---
# Stimulus media are large binaries and are distributed outside git.
# See README.md for the expected assets/ layout.
*.mp4
*.wav
*.mp3
*Zone.Identifier
# Raw camera/audio recordings and the prepared stimulus tree that
# tools/prepare_stimuli.py writes (Adım 2).  Anchored to the repository root:
# an unanchored "stimuli/" also matches the mcgurk/stimuli/ source package.
raw_recordings/
/stimuli/

# --- Installers / large binaries ---
# Nothing that ships an interpreter or toolchain belongs in the repository.
*.exe
*.msi
*.zip

# --- Python ---
__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Participant data (KVKK) ---
# Never commit experiment data, backups or the code<->identity mapping.
data/
backups/
logs/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.csv

# --- IDE ---
.vscode/
.idea/

# --- OS ---
.DS_Store
Thumbs.db
